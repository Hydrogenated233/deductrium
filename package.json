{
  "name": "deductrium-hott-optimization",
  "version": "2026.8.8",
  "description": "Deductrium with an optimized worker-based HoTT/type-theory engine",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "prebuild": "node scripts/clean-build.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node tests/run.mjs",
    "prebenchmark": "npm run build",
    "benchmark": "node tests/benchmarks/type-theory-complex.mjs",
    "benchmark:save": "node tests/benchmarks/save-load-memory.mjs",
    "prebenchmark:k609": "npm run build",
    "benchmark:k609": "node tests/benchmarks/k609-save-load-memory.mjs",
    "prebenchmark:k609:browser": "npm run build",
    "benchmark:k609:browser": "node tests/benchmarks/k609-browser-load.mjs",
    "prebenchmark:k609:profile": "npm run build",
    "benchmark:k609:profile": "node tests/benchmarks/k609-profile.mjs",
    "prebenchmark:k609:semantic": "npm run build",
    "benchmark:k609:semantic": "node tests/benchmarks/k609-semantic-coverage.mjs",
    "test:tt-assist-even": "node tests/tt-assist-even.test.mjs",
    "test:tt-definition-caches": "node tests/tt-worker-definition-caches.test.mjs",
    "test:tt-worker-cache": "node tests/tt-worker-cache.test.mjs",
    "test:tt-validation": "node tests/tt-validation-scheduling.test.mjs",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
