{
  "name": "deductrium-hott-optimization",
  "version": "2026.8.16",
  "description": "Deductrium with an optimized worker-based HoTT/type-theory engine",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node tests/run.mjs",
    "prebenchmark": "npm run build",
    "benchmark": "node tests/benchmarks/type-theory-complex.mjs",
    "benchmark:save": "node tests/benchmarks/save-load-memory.mjs",
    "prebenchmark:k609": "npm run build",
    "benchmark:k609": "node tests/benchmarks/k609-save-load-memory.mjs",
    "prebenchmark:k609:browser": "npm run build",
    "benchmark:k609:browser": "node tests/benchmarks/k609-browser-load.mjs",
    "prebenchmark:k609:movement": "npm run build",
    "benchmark:k609:movement": "node tests/benchmarks/k609-map-movement.mjs",
    "prebenchmark:k609:overlap": "npm run build",
    "benchmark:k609:overlap": "node tests/benchmarks/k609-map-overlap.mjs",
    "prebenchmark:k609:profile": "npm run build",
    "benchmark:k609:profile": "node tests/benchmarks/k609-profile.mjs",
    "prebenchmark:k609:semantic": "npm run build",
    "benchmark:k609:semantic": "node tests/benchmarks/k609-semantic-coverage.mjs",
    "prebenchmark:short": "npm run build",
    "benchmark:short": "node tests/benchmarks/short-expression-worker.mjs",
    "benchmark:scoped-syntax": "node tests/benchmarks/scoped-syntax-telescope.mjs",
    "prebenchmark:workspace": "npm run build",
    "benchmark:workspace": "node tests/benchmarks/theorem-workspace-index.mjs",
    "prebenchmark:issue5": "npm run build",
    "benchmark:issue5": "node tests/benchmarks/issue-5-resource-limit.mjs",
    "prebenchmark:hit3": "npm run build",
    "benchmark:hit3": "node --expose-gc tests/benchmarks/hit3-expansion.mjs",
    "test:tt-assist-even": "node tests/tt-assist-even.test.mjs",
    "test:tt-definition-caches": "node tests/tt-worker-definition-caches.test.mjs",
    "test:tt-worker-cache": "node tests/tt-worker-cache.test.mjs",
    "test:tt-process": "node tests/tt-process-transport-fallback.test.mjs && node tests/tt-process-transport-recovery.test.mjs && node tests/tt-process-transport-ordering.test.mjs && node tests/tt-process-http.test.mjs",
    "test:tt-validation": "node tests/tt-validation-scheduling.test.mjs",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-release.ps1"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
